# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password-32-bytes
POSTGRES_DB=pms
POSTGRES_PORT=5432

# Backend Configuration for native/local Go runs.
# Docker Compose overrides DB_SOURCE to use the internal "db" hostname.
APP_ENV=development
APP_ROLE=all
DB_SOURCE=postgres://postgres:change-me-postgres-password-32-bytes@localhost:5432/pms?sslmode=disable
JWT_SECRET_KEY=change-me-jwt-secret-32-byte-minimum
ADMIN_BOOTSTRAP_TOKEN=
PUBLIC_BASE_URL=http://localhost:8080
LOCAL_DOMAIN=localhost:8080
BACKEND_PORT=8080
BACKEND_WORKER_METRICS_PORT=9091
# Required in production; Prometheus uses the same value to scrape protected metrics.
METRICS_TOKEN=change-me-metrics-token-32-byte-min
REDIS_ADDR=localhost:6379
FEDERATION_BLOCKED_DOMAINS=
# Development defaults allow local HTTP federation. Production rejects this flag when enabled.
FEDERATION_ALLOW_INSECURE_HTTP=true
# Required in production and recommended everywhere for encrypting stored actor private keys.
ACTOR_PRIVATE_KEY_ENCRYPTION_KEY=change-me-actor-key-32-byte-minimum
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUSTED_PROXY_CIDRS=

# Optional OAuth login. Leave blank to hide provider buttons.
OAUTH_FRONTEND_CALLBACK_URL=http://localhost:5173/oauth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/auth/google/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URL=http://localhost:8080/auth/github/callback

# Optional GitHub API integration token. Public repos can sync without it.
GITHUB_API_TOKEN=

# Optional GitHub webhook secret for /webhooks/github push delivery verification.
GITHUB_WEBHOOK_SECRET=

# Frontend Configuration
VITE_API_URL=http://localhost:8080
FRONTEND_PORT=5173
PROMETHEUS_PORT=9090
