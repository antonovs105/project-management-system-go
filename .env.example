# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pms
POSTGRES_PORT=5432

# Backend Configuration for native/local Go runs.
# Docker Compose overrides DB_SOURCE to use the internal "db" hostname.
APP_ENV=development
APP_ROLE=all
DB_SOURCE=postgres://postgres:postgres@localhost:5432/pms?sslmode=disable
JWT_SECRET_KEY=your_secret_key_here
ADMIN_BOOTSTRAP_TOKEN=
PUBLIC_BASE_URL=http://localhost:8080
LOCAL_DOMAIN=localhost:8080
BACKEND_PORT=8080
BACKEND_WORKER_METRICS_PORT=9091
METRICS_TOKEN=
REDIS_ADDR=localhost:6379
FEDERATION_BLOCKED_DOMAINS=
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend Configuration
VITE_API_URL=http://localhost:8080
FRONTEND_PORT=5173
PROMETHEUS_PORT=9090
